# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=d2-trader

# Every published port is `conventional_base + slot`, where this checkout's slot
# is 10. The registry that assigns slots is devkit's `ports.toml` — add a
# project there rather than picking a free-looking number by hand. Re-generate
# this block with: python <devkit>/scripts/devkit_ports.py d2-trader
APP_HOST_PORT=8010
DB_HOST_PORT=5442

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The host-side URL. It must agree with DB_HOST_PORT above — that is the pairing
# that breaks first when a worktree's ports are edited by hand.
DATABASE_URL=postgresql+psycopg://d2_trader:d2_trader_local_dev@127.0.0.1:5442/d2_trader
POSTGRES_USER=d2_trader
POSTGRES_PASSWORD=d2_trader_local_dev
POSTGRES_DB=d2_trader

# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------
# Traderie's Terms of Service, section 4, forbid automated access. The operator runs it
# on, for personal use, accepting that risk; see README, "Data sources". Without it the
# app has little to go on.
TRADERIE_ENABLED=true
DIABLO2IO_ENABLED=true
# Each gap between requests to a site is its minimum stretched by a random 0-100%.
PACE_JITTER=1.0

# ---------------------------------------------------------------------------
# Push notifications (optional)
# ---------------------------------------------------------------------------
# The dashboard's inbox always works. Either of these also pushes to your phone.
# A Discord webhook URL, from Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=
# A full ntfy topic URL. Anyone who knows a public topic's name can read it.
NTFY_URL=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=d2-trader
OTEL_RESOURCE_ATTRIBUTES=service.name=d2-trader,service.instance.id=d2-trader,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
